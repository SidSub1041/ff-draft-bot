{
  "manifest_version": 3,
  "name": "Draft Copilot",
  "version": "1.0.0",
  "description": "Docks your draft copilot beside a Sleeper or Yahoo draft room. Advisory only - it never makes a pick and never reads the page.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*",
        "https://*.sleeper.com/*",
        "https://sleeper.app/*",
        "https://*.sleeper.app/*",
        "https://*.fantasysports.yahoo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.css"
      ],
      "matches": [
        "https://sleeper.com/*",
        "https://*.sleeper.com/*",
        "https://sleeper.app/*",
        "https://*.sleeper.app/*"
      ]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Draft Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}

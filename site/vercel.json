{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!app$|app\\.js$|styles\\.css$|fonts/|api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "https://sids-draft-copilot.fly.dev/app"
    },
    {
      "source": "/app.js",
      "destination": "https://sids-draft-copilot.fly.dev/app.js"
    },
    {
      "source": "/styles.css",
      "destination": "https://sids-draft-copilot.fly.dev/styles.css"
    },
    {
      "source": "/fonts/:file",
      "destination": "https://sids-draft-copilot.fly.dev/fonts/:file"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sids-draft-copilot.fly.dev/api/:path*"
    }
  ]
}
